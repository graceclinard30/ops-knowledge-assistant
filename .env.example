# Copy to .env and fill in. Alternatively run `ant auth login` and leave this unset.
ANTHROPIC_API_KEY=

# Optional overrides
RAG_MODEL=claude-sonnet-5-5
RAG_DATA_DIR=data/raw
RAG_STORAGE_DIR=storage
RAG_COLLECTION=documents
RAG_TOP_K=5
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_FEEDBACK_DB=data/feedback.db

# Public hosting: hide upload/rebuild/status controls and cap Claude questions per visitor
PUBLIC_DEMO=false
DEMO_QUESTION_LIMIT=10
